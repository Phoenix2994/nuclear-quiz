},{"id":"fnv-giant_ant","name":"Giant ant","page":"Giant ant (Fallout: New Vegas)","img":"img/creatures/fnv-giant_ant.webp","w":360,"h":260,"level":6,"speed":"normal","body":"arthropod","hp":75,"dmg":30,"notes":[{"en":"Hitting their antennae will count towards a critical hit and will also frenzy them.","it":"Colpire le antenne conta per un colpo critico e le manda in frenesia."}],"derived":["speed"]},{"id":"fnv-giant_mantis","name":"Giant mantis","page":"Giant mantis (Fallout: New Vegas)","img":"img/creatures/fnv-giant_mantis.webp","w":360,"h":289,"level":3,"speed":"fast","body":"arthropod","hp":50,"dmg":25,"antennae":true,"notes":[{"en":"If a mantis' antennae becomes crippled, it will become frenzied and the mantis will begin to attack anything within reach.","it":"Se le antenne di una mantide vengono storpiate, questa va in frenesia e inizia ad attaccare tutto ciò che è a portata."}],"derived":["speed"]},{"id":"fnv-giant_rat","name":"Giant rat","page":"Giant rat (Fallout: New Vegas)","img":"img/creatures/fnv-giant_rat.webp","w":360,"h":251,"level":2,"speed":"normal","body":"humanoid","hp":24,"dmg":15,"derived":["speed","body"]},{"id":"fnv-glowing_one","name":"Glowing one","page":"Glowing one","img":"img/creatures/fnv-glowing_one.webp","w":229,"h":360,"level":6,"speed":"normal","body":"humanoid","derived":["level","speed","hp","dmg"]},{"id":"fnv-lakelurk","name":"Lakelurk","page":"Lakelurk","img":"img/creatures/fnv-lakelurk.webp","w":299,"h":360,"level":13,"speed":"slow","body":"humanoid","hp":150,"dmg":110,"derived":["speed"]},{"id":"fnv-mole_rat","name":"Mole rat","page":"Mole rat (Fallout: New Vegas)","img":"img/creatures/fnv-mole_rat.webp","w":360,"h":239,"level":4,"speed":"slow","body":"beast","hp":35,"dmg":20,"derived":["speed"]},{"id":"fnv-radroach","name":"Radroach","page":"Radroach (Fallout: New Vegas)","img":"img/creatures/fnv-radroach.webp","w":360,"h":203,"level":1,"speed":"normal","body":"arthropod","hp":12,"dmg":5,"derived":["speed"]},{"id":"fnv-radsc